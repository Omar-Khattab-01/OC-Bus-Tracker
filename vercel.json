{
  "rewrites": [
    {
      "source": "/canada-day-paddles",
      "destination": "/api/retired-holiday-paddles?view=page"
    },
    {
      "source": "/civic-holiday-paddles",
      "destination": "/api/retired-holiday-paddles?view=page"
    },
    {
      "source": "/api/canada-day-paddles",
      "destination": "/api/retired-holiday-paddles"
    },
    {
      "source": "/api/civic-holiday-paddles",
      "destination": "/api/retired-holiday-paddles"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/live-bus-paddles",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-booking-batches",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/gtfs-static-check",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/support/*.js": {
      "maxDuration": 60
    },
    "api/admin/gtfs-static.js": {
      "maxDuration": 60
    },
    "api/cron/gtfs-static-check.js": {
      "maxDuration": 60
    },
    "api/cron/live-bus-paddles.js": {
      "maxDuration": 300
    }
  }
}
